# Alpha-Beta Pruning Algorithm

def alpha_beta(depth, node, is_max, scores, alpha, beta):
    if depth == 3:
        return scores[node]

    if is_max:
        best = -999

        for i in range(2):
            value = alpha_beta(depth + 1, node * 2 + i,
                              False, scores, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = 999

        for i in range(2):
            value = alpha_beta(depth + 1, node * 2 + i,
                              True, scores, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                break

        return best


scores = [3, 5, 6, 9, 1, 2, 0, -1]

result = alpha_beta(0, 0, True, scores, -999, 999)

print("Optimal value:", result)
