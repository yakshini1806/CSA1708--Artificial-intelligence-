# Decision Tree using Python

from sklearn.tree import DecisionTreeClassifier

# Training data
X = [[1, 1], [1, 0], [0, 1], [0, 0]]
y = [1, 1, 0, 0]

# Create Decision Tree model
model = DecisionTreeClassifier()

# Train the model
model.fit(X, y)

# Predict output
result = model.predict([[1, 1]])

print("Predicted Output:", result[0])
