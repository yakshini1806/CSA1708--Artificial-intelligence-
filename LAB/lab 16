# Feed Forward Neural Network

from sklearn.neural_network import MLPClassifier

# Training data
X = [[0, 0], [0, 1], [1, 0], [1, 1]]
y = [0, 1, 1, 0]

# Create neural network model
model = MLPClassifier(hidden_layer_sizes=(4,),
                      max_iter=5000,
                      random_state=1)

# Train the model
model.fit(X, y)

# Predict output
result = model.predict([[0, 1]])

print("Predicted Output:", result[0])
