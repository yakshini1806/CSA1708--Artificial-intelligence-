from collections import deque

# Goal state
GOAL = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

# Possible movements of the blank tile
MOVES = {
    'Up': -3,
    'Down': 3,
    'Left': -1,
    'Right': 1
}


def get_neighbors(state):
    """Generate all valid neighboring states."""
    neighbors = []

    zero_pos = state.index(0)
    row = zero_pos // 3
    col = zero_pos % 3

    for move, change in MOVES.items():
        new_pos = zero_pos + change

        # Check whether the move is valid
        if move == 'Up' and row == 0:
            continue
        if move == 'Down' and row == 2:
            continue
        if move == 'Left' and col == 0:
            continue
        if move == 'Right' and col == 2:
            continue

        # Swap blank tile with the selected tile
        new_state = list(state)
        new_state[zero_pos], new_state[new_pos] = \
            new_state[new_pos], new_state[zero_pos]

        neighbors.append((tuple(new_state), move))

    return neighbors


def solve(start):
    """Solve the 8-puzzle using BFS."""
    queue = deque([(start, [])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        # Goal reached
        if state == GOAL:
            return path

        for new_state, move in get_neighbors(state):
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + [move]))

    return None


def print_board(state):
    """Print the puzzle in 3x3 format."""
    for i in range(0, 9, 3):
        print(state[i], state[i + 1], state[i + 2])
    print()


# Main program
print("Enter the initial state (use 0 for the blank):")

start = tuple(map(int, input().split()))

if len(start) != 9 or set(start) != set(range(9)):
    print("Invalid input!")
else:
    solution = solve(start)

    if solution is None:
        print("No solution exists.")
    else:
        print("\nInitial State:")
        print_board(start)

        print("Number of moves:", len(solution))
        print("Moves:", " -> ".join(solution))

        # Display each step
        current = start

        for move in solution:
            for new_state, new_move in get_neighbors(current):
                if new_move == move:
                    current = new_state
                    print("Move:", move)
                    print_board(current)
                    break

